{
  "general": {
    "enableNotifications": true
  },
  "security": {
    "enablePermanentToolApproval": true,
    "environmentVariableRedaction": {
      "enabled": true
    }
  },
  "context": {
    "fileFiltering": {
      "respectGitIgnore": true,
      "respectGeminiIgnore": true
    },
    "loadMemoryFromIncludeDirectories": true
  },
  "tools": {
    "sandbox": true
  },
  "experimental": {
    "enableAgents": true
  }
}
