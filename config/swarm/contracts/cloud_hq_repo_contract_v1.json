{
    "schema_version": "local_owner_runtime_contract_v1",
    "repo_identity": {
        "repo_name": "heiwa",
        "github_repo": "Heiwa-Limited/heiwa-universe",
        "role": "owner_runtime"
    },
    "runtime": {
        "target": "macbook_rust_shell"
    },
    "boundaries": {},
    "cli_surface": {
        "primary_entrypoint": "heiwa",
        "compatibility_aliases": [
            "heiwa-hub",
            "heiwa-cli"
        ]
    },
    "command_refs": {
        "local_runtime_status": {
            "command": "heiwa app runtime status --json",
            "cwd": ".",
            "mode": "exec",
            "read_only": true
        },
        "local_app_update_dry_run": {
            "command": "heiwa app update --dry-run",
            "cwd": ".",
            "mode": "exec",
            "read_only": true
        },
        "github_env_audit": {
            "command": "gh api repos/Heiwa-Limited/heiwa-universe",
            "cwd": ".",
            "mode": "exec",
            "read_only": true
        }
    },
    "providers": {},
    "observability": {}
}
