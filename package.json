{
  "name": "heiwa-universe",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Heiwa-Limited/heiwa-universe.git"
  },
  "homepage": "https://github.com/Heiwa-Limited/heiwa-universe",
  "bugs": {
    "url": "https://github.com/Heiwa-Limited/heiwa-universe/issues"
  },
  "engines": {
    "node": "26.x"
  },
  "workspaces": [
    "apps/heiwa_app",
    "apps/heiwa_app/clients/cockpit"
  ],
  "scripts": {
    "check:runtime": "bash scripts/check_runtime_baseline.sh",
    "lint": "biome ci .",
    "typecheck": "tsc -p apps/heiwa_app/tsconfig.json --noEmit && npm --prefix apps/heiwa_app/clients/cockpit run typecheck",
    "test:system1": "npm --prefix packages/heiwa_system1 test",
    "typecheck:system1": "npm --prefix packages/heiwa_system1 run typecheck",
    "demo:system1": "node packages/heiwa_system1/src/examples/routing_agent/demo.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "typescript": "5.9.3",
    "typescript-language-server": "^5.1.3"
  }
}
