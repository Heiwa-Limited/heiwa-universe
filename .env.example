# Heiwa Environment Variables — canonical reference
# Copy to .env and fill in real values. DO NOT commit .env.
# SECRET values (marked ★) belong in Doppler, not local files.

# ─── Auth ──────────────────────────────────────────────────────────────────
HEIWA_MACHINE_AUTH_TOKEN=                 # ★ canonical worker/operator machine auth token
HEIWA_JWT_SIGNING_SECRET=                 # ★ canonical user session signing secret
# Legacy fallbacks remain temporarily supported:
HEIWA_AUTH_TOKEN=                         # ★ legacy machine auth fallback
HEIWA_AUTH_SECRET=                        # ★ legacy JWT signing fallback
OWNER_ID=                                 # Your Heiwa owner ID
HEIWA_MASTER_KEY=                         # ★ Vault master key (Fernet)

# ─── State backend ─────────────────────────────────────────────────────────
HEIWA_STATE_BACKEND=local-jsonl            # canonical local evidence backend
# HEIWA_EVIDENCE_DIR=~/.heiwa/evidence     # optional override

# ─── Node identity ─────────────────────────────────────────────────────────
HEIWA_NODE_ID=macbook@heiwa-agile
HEIWA_NODE_TYPE=orchestrator              # orchestrator | worker
NODE_ENV=development                      # development | production

# ─── LLM Providers ────────────────────────────────────────────────────────
HEIWA_OLLAMA_URL=http://127.0.0.1:11434
GEMINI_API_KEY=                           # ★ Google AI API key
ANTHROPIC_API_KEY=                        # ★ Anthropic API key
OPENAI_API_KEY=                           # ★ OpenAI API key

# ─── Memory & Indexing ─────────────────────────────────────────────────────
HEIWA_INDEX_ON_BOOT=false                 # re-index repo on hub start
HEIWA_EMBED_SYNC_ON_APPEND=false
HEIWA_EMBED_BACKEND=lance                 # lance | sqlite
HEIWA_EMBED_MODEL=qwen3-embedding:0.6b
# HEIWA_EMBED_LANCE_PATH=~/.heiwa/state/lance  # optional override
HEIWA_EMBED_DIM=1024

# ─── Discord (Control Plane + OAuth) ──────────────────────────────────────
DISCORD_BOT_TOKEN=                        # ★ Discord bot token
DISCORD_APPLICATION_ID=                   # Discord app ID (for OAuth)
DISCORD_CLIENT_SECRET=                    # ★ Discord OAuth client secret
DISCORD_GUILD_ID=0

# ─── User Auth (JWT Sessions) ────────────────────────────────────────────
HEIWA_OAUTH_REDIRECT_URI=                # Override callback URL (default: {HUB_URL}/auth/discord/callback)
HEIWA_WEB_ORIGIN=http://127.0.0.1:7474   # Web dashboard origin for post-auth redirect

# ─── Hub & Network ─────────────────────────────────────────────────────────
PORT=7474
HEIWA_HUB_URL=http://127.0.0.1:7474

# ─── Feature flags ─────────────────────────────────────────────────────────
HEIWA_AUTO_APPROVE=cli                    # cli | always | never
HEIWA_EXECUTOR_RUNTIME=macbook           # macbook | local | auto

# ─── Monitoring ────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
SENTRY_AUTH_TOKEN=                        # ★ Sentry auth token
