# Heiwa Environment Variables — canonical reference
# Copy to .env and fill in real values. DO NOT commit .env.
# SECRET values (marked ★) belong in Doppler, not local files.
#
# Load priority (load_swarm_env): .env → .env.worker.local → ~/.heiwa/vault.env
# With Doppler: doppler run -- ./apps/heiwa_cli/heiwa ...

# ─── Auth ──────────────────────────────────────────────────────────────────
HEIWA_AUTH_TOKEN=                         # ★ CLI + hub API auth token
HEIWA_AUTH_MODE=payload_token             # payload_token | header_token
OWNER_ID=                                 # Your Heiwa owner ID
HEIWA_MASTER_KEY=                         # ★ Vault master key (Fernet)

# ─── State backend ─────────────────────────────────────────────────────────
HEIWA_STATE_BACKEND=spacetimedb            # spacetimedb | postgres | sqlite
DATABASE_URL=                             # Postgres connection string (if postgres)
DATABASE_PATH=./hub.db                    # SQLite path (if sqlite)

# ─── SpacetimeDB ───────────────────────────────────────────────────────────
STDB_IDENTITY=heiwaproductiondb            # SpacetimeDB database name
STDB_SERVER=local                         # local | maincloud

# NATS removed — transport now uses in-process LocalBusTransport + WebSocket (see transport.py)

# ─── Node identity ─────────────────────────────────────────────────────────
HEIWA_NODE_ID=macbook@heiwa-agile
HEIWA_NODE_TYPE=orchestrator              # orchestrator | worker | mobile_node
NODE_IP=127.0.0.1
NODE_ENV=development                      # development | production

# ─── LLM — Ollama (Tier 1: free, local) ───────────────────────────────────
HEIWA_ENABLE_OLLAMA=true
HEIWA_OLLAMA_URL=http://127.0.0.1:11434
HEIWA_OLLAMA_MODEL=qwen3.5:4b
HEIWA_OLLAMA_FALLBACK_MODEL=llama3.2:3b
HEIWA_OLLAMA_TIMEOUT_SEC=60
HEIWA_OLLAMA_TEMPERATURE=0.2
HEIWA_OLLAMA_NUM_CTX=8192
HEIWA_OLLAMA_MAX_PROMPT_CHARS=120000
HEIWA_LLM_MODE=local_only                # local_only | remote | auto

# ─── LLM — Gemini (Tier 2: Google AI Pro) ─────────────────────────────────
GEMINI_API_KEY=                           # ★ Google AI API key
HEIWA_GEMINI_FLASH_MODEL=gemini-2.5-flash
HEIWA_GEMINI_PRO_MODEL=gemini-2.5-pro
HEIWA_GEMINI_TIMEOUT_SEC=30

# ─── LLM — Anthropic Claude (Tier 3: premium) ─────────────────────────────
ANTHROPIC_API_KEY=                        # ★ Anthropic API key
HEIWA_ANTHROPIC_MODEL=claude-sonnet-4-6
HEIWA_ANTHROPIC_TIMEOUT_SEC=45

# ─── LLM — OpenAI (Tier 4: fallback) ──────────────────────────────────────
OPENAI_API_KEY=                           # ★ OpenAI API key
HEIWA_OPENAI_MODEL=gpt-4o
HEIWA_OPENAI_TIMEOUT_SEC=45

# ─── Discord ───────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=                        # ★ Discord bot token
DISCORD_APPLICATION_ID=
DISCORD_GUILD_ID=0
DISCORD_WEBHOOK_URL=                      # ★ Discord webhook URL
HEIWA_DISCORD_SMOKE_CHANNEL_ID=
HEIWA_OPERATOR_INPUT_CHANNEL_ID=
HEIWA_LISTEN_CHANNEL_IDS=                 # Comma-separated channel IDs

# ─── Hub & Network ─────────────────────────────────────────────────────────
HEIWA_HUB_URL=
HEIWA_HUB_BASE_URL=
HEIWA_HUB_FALLBACK_URL=
PORT=8080

# ─── Feature flags ─────────────────────────────────────────────────────────
HEIWA_ENABLE_BROKER=true
HEIWA_ENABLE_BRIDGE=false
HEIWA_ENABLE_MESSENGER=false              # auto-detected if DISCORD_BOT_TOKEN set
HEIWA_AUTO_APPROVE=cli                    # cli | always | never
HEIWA_APPROVAL_TIMEOUT_SEC=600

# ─── Executor ──────────────────────────────────────────────────────────────
HEIWA_EXECUTOR_CONCURRENCY=4
HEIWA_EXECUTOR_RUNTIME=auto              # railway | macbook | auto
HEIWA_WORKER_WARM_TTL_SEC=600

# ─── Monitoring ────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
SENTRY_AUTH_TOKEN=                        # ★ Sentry auth token
SENTRY_ORG=
SENTRY_PROJECT=
REDIS_URL=                                # Optional: Redis for caching

# ─── Railway (auto-set in Railway environment) ─────────────────────────────
# RAILWAY_ENVIRONMENT_NAME=production
# RAILWAY_PROJECT_ID=
# RAILWAY_PUBLIC_DOMAIN=

# ─── CLI / Tracing ─────────────────────────────────────────────────────────
HEIWA_TRACE=false
LOG_LEVEL=INFO
