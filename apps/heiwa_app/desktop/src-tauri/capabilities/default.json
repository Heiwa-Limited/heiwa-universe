{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default Heiwa desktop window capability. No `remote` block is declared, so this grant covers only the app's own local content in the `main` window, never a remote-navigated origin. Every app command is listed explicitly (least privilege): a command left off this list cannot be invoked from the webview at all, regardless of what `lib.rs` registers.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "updater:default",
    "allow-herd-command-catalog",
    "allow-herd-pane-focus",
    "allow-herd-pane-read",
    "allow-herd-pane-run",
    "allow-herd-pane-send",
    "allow-herd-pane-split",
    "allow-herd-panes",
    "allow-apple-mail-scan",
    "allow-establish-identity",
    "allow-onboarding-state",
    "allow-complete-workspace-setup",
    "allow-open-resource-guide",
    "allow-connect-api-provider",
    "allow-verify-api-provider",
    "allow-disconnect-api-provider",
    "allow-operator-subscribe",
    "allow-operator-unsubscribe",
    "allow-api-get",
    "allow-api-post",
    "allow-runtime-health",
    "allow-update-check",
    "allow-update-install"
  ]
}
