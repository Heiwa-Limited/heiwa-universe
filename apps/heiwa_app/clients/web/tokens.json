{
  "meta": {
    "name": "Heiwa",
    "colorScheme": "dark-only",
    "version": "1.0.0",
    "source": "apps/heiwa_app/clients/web/assets/styles.css"
  },
  "color": {
    "bg":      { "value": "#081015",              "comment": "near-black teal base" },
    "bg2":     { "value": "#121f29",              "comment": "elevated surface" },
    "bg3":     { "value": "#172633",              "comment": "third surface elevation" },
    "ink":     { "value": "#e9f0f4",              "comment": "primary text" },
    "muted":   { "value": "#9eb1bf",              "comment": "secondary text" },
    "line":    { "value": "rgba(233,240,244,0.12)","comment": "borders" },
    "card":    { "value": "rgba(255,255,255,0.03)","comment": "glass surface" },
    "accent":  { "value": "#f28c28",              "comment": "orange — primary brand" },
    "accent2": { "value": "#31c5a8",              "comment": "teal — secondary brand" },
    "accent3": { "value": "#9fd9ff",              "comment": "pale blue — tertiary accent" },
    "warn":    { "value": "#f0b429",              "comment": "warning state" },
    "bad":     { "value": "#e05d5d",              "comment": "error/fail state" },
    "good":    { "value": "#2fc27e",              "comment": "success/ok state" }
  },
  "typography": {
    "sans": { "value": "'Space Grotesk', system-ui, sans-serif" },
    "mono": { "value": "'IBM Plex Mono', ui-monospace, monospace" },
    "heroSize":    { "value": "clamp(2rem, 6vw, 4.4rem)" },
    "heroMaxWidth":{ "value": "14ch" },
    "eyebrowFont": { "value": "mono" },
    "eyebrowCase": { "value": "uppercase" },
    "eyebrowTracking": { "value": "0.12em" }
  },
  "spacing": {
    "space1": { "value": "0.35rem" },
    "space2": { "value": "0.5rem" },
    "space3": { "value": "0.7rem" },
    "space4": { "value": "0.8rem" },
    "space5": { "value": "1rem" },
    "space6": { "value": "1.2rem" }
  },
  "radius": {
    "pill":  { "value": "999px" },
    "card":  { "value": "20px" },
    "panel": { "value": "14px", "comment": "14–22px range; use 22px for large panels" }
  },
  "shadow": {
    "default": { "value": "0 24px 60px rgba(0,0,0,0.35)" }
  },
  "grid": {
    "columns": { "value": "12" },
    "template": { "value": "repeat(12, minmax(0, 1fr))" },
    "gap":      { "value": "1rem" }
  },
  "effect": {
    "backdropOrange": { "value": "radial-gradient(circle at 15% 10%, rgba(242,140,40,0.15), transparent)" },
    "backdropTeal":   { "value": "radial-gradient(circle at 90% 20%, rgba(49,197,168,0.20), transparent)" },
    "bgGradient":     { "value": "linear-gradient(180deg, var(--bg), var(--bg2))" }
  },
  "component": {
    "btnSolid":   { "value": "linear-gradient(135deg, #f28c28, #e07320)", "comment": "orange gradient, dark ink text" },
    "statusOk":   { "value": "#2fc27e" },
    "statusWarn": { "value": "#f0b429" },
    "statusFail": { "value": "#e05d5d" }
  }
}
