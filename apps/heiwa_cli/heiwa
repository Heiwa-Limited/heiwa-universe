#!/usr/bin/env python3
"""Heiwa CLI entry point — thin wrapper that delegates to heiwa_cli package.

Handles root discovery and venv escalation, then hands off to the package.
"""

import os
import sys
from pathlib import Path


def find_monorepo_root(start_path: Path) -> Path:
    """Walk up to find the monorepo root containing 'apps' and 'packages'."""
    explicit = os.environ.get("HEIWA_ROOT")
    if explicit:
        p = Path(explicit).resolve()
        if (p / "apps").exists() and (p / "packages").exists():
            return p
    current = start_path.resolve()
    for _ in range(6):
        if (current / "apps").exists() and (current / "packages").exists():
            return current
        if current.parent == current:
            break
        current = current.parent
    print("[FATAL] Could not find Heiwa monorepo root. Set HEIWA_ROOT or run from inside the repo.", file=sys.stderr)
    sys.exit(1)


MONOREPO_ROOT = find_monorepo_root(Path(__file__).resolve().parent)
PACKAGES_ROOT = MONOREPO_ROOT / "packages"
APPS_ROOT = MONOREPO_ROOT / "apps"
VENV_BIN = MONOREPO_ROOT / ".venv/bin/python3"

# Always export the canonical repo roots so child processes and wrappers do not
# fall back to the nested apps/heiwa_cli subtree when the CLI is already inside
# the venv or launched via python -m.
os.environ.setdefault("HEIWA_ROOT", str(MONOREPO_ROOT))
os.environ.setdefault("HEIWA_WORKSPACE_ROOT", str(MONOREPO_ROOT))

# Ensure local packages are discoverable
for pkg in ("heiwa_cli", "heiwa_cognition", "heiwa_sdk", "heiwa_protocol", "heiwa_identity", "heiwa_ui"):
    sys.path.insert(0, str(PACKAGES_ROOT / pkg))
sys.path.insert(0, str(APPS_ROOT))

# Venv escalation: re-exec under .venv/bin/python3 if available
if VENV_BIN.exists() and sys.executable != str(VENV_BIN):
    os.environ["PYTHONPATH"] = ":".join([
        str(PACKAGES_ROOT / pkg)
        for pkg in ("heiwa_cli", "heiwa_cognition", "heiwa_sdk", "heiwa_protocol", "heiwa_identity", "heiwa_ui")
    ] + [str(APPS_ROOT)])
    os.execv(str(VENV_BIN), [str(VENV_BIN)] + sys.argv)

from heiwa_cli.__main__ import main

if __name__ == "__main__":
    main()
